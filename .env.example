# Copy to .env (gitignored) and fill in, or export these in your shell.
# mothbake never writes the key to disk: it is read from the environment only.

# Required to talk to the API (run/catalog when jobs are not recorded fixtures).
MOTH_API_KEY=

# Optional: override the API base URL. Default: https://api.mothquantum.com
# MOTH_API_BASE=https://api.mothquantum.com
