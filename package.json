{
  "name": "mothbake",
  "version": "0.1.0",
  "description": "Local-first asset variation workbench with credit-safe Moth execution, offline rebuilds, approvals and engine-ready exports.",
  "license": "MIT",
  "author": "mojomast",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mothbake": "./bin/mothbake.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./api": "./src/api.mjs",
    "./approvals": "./src/approvals.mjs",
    "./approved-export": "./src/approved-export.mjs",
    "./archive": "./src/archive.mjs",
    "./audio-quality": "./src/audio-quality.mjs",
    "./backends": "./src/backends/index.mjs",
    "./bakers": "./src/bakers/index.mjs",
    "./config": "./src/config.mjs",
    "./candidates": "./src/candidates.mjs",
    "./decoders": "./src/decoders/index.mjs",
    "./decoders/*": "./src/decoders/*.mjs",
    "./emitters": "./src/emitters/index.mjs",
    "./emitters/audio-pack-versioned": "./src/emitters/audio-pack-versioned.mjs",
    "./emitters/godot": "./src/emitters/godot.mjs",
    "./execution-plan": "./src/execution-plan.mjs",
    "./gc": "./src/gc.mjs",
    "./engine-contracts": "./src/engine-contracts.mjs",
    "./identity": "./src/identity.mjs",
    "./image": "./src/image.mjs",
    "./job-graph": "./src/job-graph.mjs",
    "./material-family": "./src/material-family.mjs",
    "./media-structure": "./src/media-structure.mjs",
    "./publish": "./src/publish.mjs",
    "./repair": "./src/repair.mjs",
    "./runner": "./src/runner.mjs",
    "./run-journal": "./src/run-journal.mjs",
    "./sources": "./src/sources.mjs",
    "./transactional-pack": "./src/transactional-pack.mjs",
    "./values": "./src/values.mjs",
    "./variations": "./src/variations.mjs",
    "./workbench": "./src/workbench-server.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "examples/",
    "python/",
    "CHANGELOG.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "assets",
    "bake",
    "pipeline",
    "manifest",
    "codegen",
    "png",
    "gif",
    "wav",
    "hdr",
    "zip",
    "sprite-sheet",
    "decoder",
    "zero-dependencies"
  ],
  "dependencies": {},
  "devDependencies": {}
}
