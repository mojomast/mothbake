{
  "name": "mothbake",
  "version": "0.1.0",
  "description": "Manifest-driven asset baking: submit engine jobs, decode results with zero dependencies, and emit portable files, JSON bundles, or generated ES modules.",
  "license": "MIT",
  "author": "mojomast",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mothbake": "./bin/mothbake.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./api": "./src/api.mjs",
    "./bakers": "./src/bakers/index.mjs",
    "./config": "./src/config.mjs",
    "./decoders": "./src/decoders/index.mjs",
    "./decoders/*": "./src/decoders/*.mjs",
    "./emitters": "./src/emitters/index.mjs",
    "./image": "./src/image.mjs",
    "./runner": "./src/runner.mjs",
    "./sources": "./src/sources.mjs",
    "./values": "./src/values.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "assets",
    "bake",
    "pipeline",
    "manifest",
    "codegen",
    "png",
    "gif",
    "wav",
    "hdr",
    "zip",
    "sprite-sheet",
    "decoder",
    "zero-dependencies"
  ],
  "dependencies": {},
  "devDependencies": {}
}
